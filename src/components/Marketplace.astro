---
import { marketplace } from '@/data/traction';
---

<section class="border-b border-rule bg-paper-deep">
  <div class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
    <p class="eyebrow">02 &middot; The hard part</p>
    <h2 class="display mt-3 max-w-2xl text-3xl sm:text-4xl">
      Two-sided, without the cold start
    </h2>

    <div class="mt-10 grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-12">
      {
        marketplace.map((side) => (
          <div class="reveal">
            <div class="flex items-baseline gap-3">
              <span class="display text-2xl text-accent">{side.side}</span>
              <span class="h-px flex-1 bg-rule"></span>
            </div>
            <h3 class="display mt-4 text-2xl leading-tight sm:text-[1.75rem]">{side.title}</h3>
            <p class="mt-4 text-[1.0625rem] leading-relaxed text-ink-soft">{side.body}</p>
            <ul class="mt-5 space-y-3">
              {side.points.map((p) => (
                <li class="flex gap-3 text-sm leading-relaxed text-ink-soft">
                  <span class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 bg-accent"></span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
