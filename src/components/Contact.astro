---
import { contact, company } from '@/data/traction';
---

<footer class="bg-paper">
  <div class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
    <h2 class="display max-w-2xl text-3xl leading-tight sm:text-4xl">
      Happy to walk through the data room.
    </h2>

    <div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-3">
      <div>
        <p class="eyebrow">Contact</p>
        <p class="mt-2 text-lg font-semibold tracking-tight">{contact.name}</p>
        <p class="mt-1 text-sm"><span class="blank">{contact.email}</span></p>
      </div>
      <div>
        <p class="eyebrow">Deck</p>
        <p class="mt-2 text-sm"><span class="blank">{contact.deck}</span></p>
      </div>
      <div>
        <p class="eyebrow">Also</p>
        <p class="mt-2 text-sm text-ink-soft">{contact.site}</p>
      </div>
    </div>

    <hr class="rule my-10" />

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-muted">
        {company.name} &middot; Investor brief, {company.updated} &middot; Confidential
      </p>
      <button
        class="no-print self-start border border-ink px-4 py-2 text-sm font-semibold transition-colors hover:bg-ink hover:text-paper"
        onclick="window.print()"
        type="button"
      >
        Print / save as PDF
      </button>
    </div>
  </div>
</footer>
