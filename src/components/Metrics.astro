---
import { metrics } from '@/data/traction';
---

<section class="border-b border-rule">
  <div class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
    <p class="eyebrow">01 &middot; Traction</p>
    <h2 class="display mt-3 text-3xl sm:text-4xl">The numbers</h2>

    <dl class="mt-8 grid grid-cols-1 gap-px bg-rule sm:grid-cols-2 lg:grid-cols-3">
      {
        metrics.map((m) => (
          <div class="reveal bg-paper px-5 py-6 sm:px-6 sm:py-7">
            <dd
              class={`display text-4xl sm:text-5xl ${m.blank ? 'blank text-3xl sm:text-4xl' : ''}`}
            >
              {m.value}
            </dd>
            <dt class="mt-3 text-sm font-semibold tracking-tight">{m.label}</dt>
            {m.note && <p class="mt-1 text-sm text-muted">{m.note}</p>}
          </div>
        ))
      }
    </dl>

    <p class="mt-6 text-sm leading-relaxed text-muted">
      Figures in <span class="blank">amber</span> are blanks for Jon to fill, not estimates. Nothing
      on this page is modelled or projected.
    </p>
  </div>
</section>
